{
  "name": "enlace-js",
  "private": true,
  "version": "0.1.0",
  "description": "Node/JS adapters for Enlace. See github.com/get-enlace/enlace-ui for the canvas UI itself and the overall architecture.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/get-enlace/enlace-js.git"
  },
  "type": "module",
